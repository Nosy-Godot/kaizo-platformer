<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>kaizoproject</RootNamespace>
    <IncludeGdUnitTests Condition=" '$(Configuration)' != 'ExportRelease' ">true</IncludeGdUnitTests>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modules are separate projects; without this the Godot SDK globs and compiles their sources too. -->
    <Compile Remove="Modules/**" />
    <ProjectReference Include="Modules/Nosy.FSM/Nosy.FSM.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(IncludeGdUnitTests)' == 'true' ">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(IncludeGdUnitTests)' != 'true' ">
    <Compile Remove="Tests/**" />
    <!-- Generated by the GdUnit4 adapter on every test run. -->
    <Compile Remove="gdunit4_testadapter_v*/**" />
  </ItemGroup>
</Project>
